# Panorama settings. Copy the lines you need into .env. Secrets are never here:
# the "secrets" service makes them in Docker volumes.

# ---- Default mode (committed .env) -------------------------------------------
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
COMPOSE_PROFILES=bundled-llm
DATASET=sample
API_REPLICAS=2
API_WORKERS=1
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://ollama:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_PARALLEL=4
LLM_ENDPOINTS=
LLM_MAX_WAIT_S=20
LLM_TURN_ESTIMATE_S=8
AUTO_PULL_MODEL=true
DEMO_MODE=true
LOADTEST_USERS=0
RAG_HNSW_THRESHOLD=50000
AUDIT_QUERY_RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=90
CHAT_RETENTION_DAYS=90

# ---- Large data -----------------------------------------------------------------
# The first init generates and loads 1,000,000 synthetic orders (approximately 2-4 minutes).
# DATASET=1m
# Other sizes for experiments (only 1m is verified):
# DATASET=custom
# DATASET_ROWS=10000000

# ---- No NVIDIA GPU (CPU only) -------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_PARALLEL=1
# LLM_NUM_THREAD=6
# OLLAMA_MEM_LIMIT=5g
# LLM_TURN_ESTIMATE_S=45
# LLM_MAX_WAIT_S=60

# ---- Quality mode (larger model, 1 slot; also passes all eval gates, 2-3x slower) ----
# The default is the 4B model with 4 slots: see backend/eval/reports/ (M10 model choice).
# LLM_MODEL=qwen3:8b
# LLM_PARALLEL=1
# LLM_TURN_ESTIMATE_S=18

# ---- vLLM (OpenAI-compatible server, high concurrency) -------------------------------
# Use only one LLM server at a time on a 6 GB GPU.
# COMPOSE_PROFILES=vllm
# LLM_PROVIDER=openai_compatible
# LLM_ENDPOINT=http://vllm:8000/v1
# LLM_MODEL=Qwen/Qwen3-4B-AWQ
# LLM_PARALLEL=8
# LLM_TURN_ESTIMATE_S=4
# VLLM_GPU_UTIL=0.75   # share of the whole GPU for vLLM; Windows itself uses ~1 GB of a 6 GB GPU

# ---- Several LLM endpoints (for example two GPU computers) ---------------------------
# The gateway balances the turns over the endpoints (most free slots, then fastest).
# LLM_ENDPOINTS=[{"name":"gpu1","provider":"ollama","url":"http://gpu1:11434","model":"qwen3:8b","slots":1},{"name":"gpu2","provider":"ollama","url":"http://gpu2:11434","model":"qwen3:8b","slots":1}]

# ---- Ollama on the host (not in Docker) ------------------------------------------------
# COMPOSE_PROFILES=
# LLM_ENDPOINT=http://host.docker.internal:11434

# ---- Load tests --------------------------------------------------------------------------
# Synthetic users lt.<scope>.<n> (only with DEMO_MODE=true)
# LOADTEST_USERS=40

# ---- Managed database (Supabase or other) -------------------------------------------------
# See docs/SCALING.md (not tested in this build).
